# AP Automation Agent v3.2 — Environment Configuration (Graph / Gmail)

# ── LLM ──────────────────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-key-here

# ── Mail provider selector ──────────────────────────────────────────
# Which backend run_ap.py talks to. "graph" = Microsoft 365/Outlook via
# Microsoft Graph API. "gmail" = Google Workspace/personal Gmail via
# the Gmail API. Only the config block for the one you pick matters —
# the other one can stay with placeholder values.
AP_MAIL_PROVIDER=graph

# ── Microsoft Graph API (used when AP_MAIL_PROVIDER=graph) ─────────
# Register an app in Azure AD (Entra ID) → App registrations → New
# registration. Grant it these APPLICATION (not delegated) permissions
# under Microsoft Graph, then click "Grant admin consent":
#   Mail.ReadWrite   — read/move messages in AP_GRAPH_MAILBOX
#   Mail.Send        — send result / review-request emails
# Create a client secret under Certificates & secrets and paste it below.
AP_GRAPH_TENANT_ID=your-azure-ad-tenant-id
AP_GRAPH_CLIENT_ID=your-app-registration-client-id
AP_GRAPH_CLIENT_SECRET=your-client-secret-value

# The mailbox this agent reads invoices from (its ToBeProcessed folder)
# and, by default, sends mail as. UPN or email address of a real or
# shared mailbox the app registration has been granted access to.
AP_GRAPH_MAILBOX=ap-invoices@yourcompany.com

# Optional: send FROM a different mailbox than the one being read
# (leave unset to send from AP_GRAPH_MAILBOX).
# AP_GRAPH_SEND_AS=ap-noreply@yourcompany.com

# ── Gmail API (used when AP_MAIL_PROVIDER=gmail) ────────────────────
# AP_GMAIL_AUTH_MODE: "service_account" (Google Workspace, unattended,
# needs a Workspace admin to authorize domain-wide delegation) or
# "oauth" (personal/any Gmail account, one-time interactive browser
# consent, then a cached refresh token). See gmail_auth.py's docstring
# for full step-by-step setup of either mode.
AP_GMAIL_AUTH_MODE=oauth

# service_account mode:
AP_GMAIL_SERVICE_ACCOUNT_FILE=gmail_service_account.json
AP_GMAIL_MAILBOX=ap-invoices@yourcompany.com

# oauth mode:
AP_GMAIL_OAUTH_CLIENT_FILE=gmail_oauth_client.json
AP_GMAIL_TOKEN_FILE=gmail_token.json

# Optional: override the visible From: header — only works if this
# address is a verified "Send mail as" alias on the authenticated
# account (Gmail Settings → Accounts → Send mail as).
# AP_GMAIL_SEND_AS=ap-noreply@yourcompany.com

# ── Email recipients ──────────────────────────────────────────────
# Who gets the final result email
AP_NOTIFY_EMAIL=saiprasad.eruventi@avaali.com

# Who gets the review request when Manual Review is triggered
AP_REVIEWER_EMAIL=saiprasad.eruventi@avaali.com

# ── Processing settings ───────────────────────────────────────────
# Variance % above which invoice goes to Manual Review
VARIANCE_THRESHOLD_PCT=2.0

# Seconds between polls in --watch mode
POLL_INTERVAL_SECONDS=30

# Optional: override the mailbox folder names the agent uses
# (defaults shown below — only set these if you renamed the folders)
# AP_SOURCE_FOLDER=ToBeProcessed
# AP_PROCESSED_FOLDER=Processed
# AP_EXCEPTIONS_FOLDER=Exceptions

# ── ERP source: live SAP (replaces the Redis mock ERP) ─────────────
# sap  = every PO / GRN / invoice lookup is a live RFC read from SAP
# mock = legacy Redis-seeded mock data (migrate_erp_to_redis.py)
AP_ERP_SOURCE=sap
# Active SAP profile: S4 (S/4HANA A4F) or ECC (AVI IDES, SAP Logon 750)
SAP_ACTIVE_SYSTEM=S4

# S/4HANA — SAP Logon entry "New IDES S4HANA" (inst 57). Use the IP: the
# gateway rejects the old hostname as4hsap01.avaali.com.
SAP_S4_ASHOST=65.2.76.131
SAP_S4_SYSNR=57
SAP_S4_CLIENT=100
SAP_S4_USER=
SAP_S4_PASSWD=
SAP_S4_LANG=EN
# SAP_S4_SAPROUTER=

# ECC — Avaali IDES (SAP Logon 750, inst 00, client 800)
SAP_ECC_ASHOST=54.169.73.118
SAP_ECC_SYSNR=00
SAP_ECC_CLIENT=800
SAP_ECC_USER=
SAP_ECC_PASSWD=
SAP_ECC_LANG=EN

# What the agent does in SAP with each decision (sap_invoice.py):
#   post     Perfect Match -> post invoice; Manual Review -> park it;
#            reviewer Approve -> post parked; Reject -> delete parked
#   simulate SAP simulation only — nothing written
#   off      no invoice postings (reads stay live)
SAP_INVOICE_MODE=post
SAP_FREIGHT_TAX_CODE=I0
SAP_REVERSAL_REASON=01

# Demo-case organisational data (sap_demo_setup.py) — S/4 1710 defaults.
# PO type ENB, not NB: NB has flexible workflow on A4F and its POs stay
# "In Release" forever (no workflow agent), which blocks goods receipts.
# SAP_DEMO_COMPANY_CODE=1710
# SAP_DEMO_PLANT=1710
# SAP_DEMO_PO_TYPE=ENB
# SAP_DEMO_COST_CENTER=0017101101
# SAP_DEMO_GL_ACCOUNT=0065100000

# ── Mock ERP (PO + GRN lookup) ─────────────────────────────────────
# Path to the Excel workbook that mocks the ERP system's PO and GRN
# data. Only used LOCALLY by migrate_erp_to_redis.py to seed Redis
# once — erp_mock.py itself now reads from Redis at runtime (needed
# for Vercel, whose filesystem is read-only/ephemeral).
AP_ERP_WORKBOOK=data/erp/ERP_Mock_Data.xlsx

# ── Redis (Upstash) — ERP data, pending HITL reviews, processed log ─
# Set by the Vercel "Upstash for Redis" / "KV" Marketplace integration
# automatically when linked to your project; set manually here for
# local dev. Vercel's integration sometimes names these KV_REST_API_URL
# / KV_REST_API_TOKEN instead — redis_store.py accepts either naming,
# so just use whichever names actually show up in your Vercel project's
# Environment Variables. Without either pair set, redis_store.py falls
# back to a non-persistent in-memory store (fine for quick local
# testing only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vercel manual-trigger endpoint ─────────────────────────────────
# Shared secret required in the X-Trigger-Secret header to call
# POST /api/process (runs one pass of the pipeline). Required — the
# endpoint refuses all requests if this is unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AP_TRIGGER_SECRET=

# ── Web Approval Portal (HITL via clickable email links) ───────────
# Base URL the review-request emails point to. Must be reachable from
# the reviewer's browser — localhost only works if the reviewer opens
# the link on the SAME machine the portal is running on. For remote
# reviewers, change this to the server's actual hostname/IP (and run
# the portal with --host 0.0.0.0, already the default in approval_portal.py).
AP_APPROVAL_PORTAL_URL=http://localhost:8000
AP_APPROVAL_PORTAL_PORT=8000
